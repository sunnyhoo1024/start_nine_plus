<view class="page">
  <view class="card profile">
    <image class="avatar" src="{{userInfo.avatarUrl || defaultAvatar}}" mode="aspectFill" />
    <view class="info">
      <view class="nickname">{{userInfo.nickname || '未登录'}}</view>
      <view class="muted" wx:if="{{userInfo.id}}">用户 ID：{{userInfo.id}}</view>
      <view class="muted" wx:else>登录后同步积分与兑换记录</view>
    </view>
  </view>

  <view class="card actions">
    <button class="btn-primary" loading="{{loading}}" bindtap="onLogin" wx:if="{{!loggedIn}}">微信登录</button>
    <button bindtap="onLogout" wx:else>退出登录</button>
  </view>
</view>
