.page {
  padding-bottom: 40rpx;
}

.banner {
  height: 320rpx;
}

.banner-img {
  width: 100%;
  height: 320rpx;
}

.intro .title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.intro .text {
  color: #606266;
  line-height: 1.6;
}

.balance {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.balance .label {
  color: #909399;
}

.balance .value {
  font-size: 48rpx;
  font-weight: 700;
  color: #1f2d3d;
}

.entries {
  display: flex;
  gap: 16rpx;
  padding: 0 24rpx;
}

.entry {
  flex: 1;
  text-align: center;
  background: #1f2d3d;
  color: #fff;
  padding: 28rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
}
