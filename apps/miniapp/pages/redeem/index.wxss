.sku {
  display: flex;
  gap: 20rpx;
}

.cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #eef1f6;
  flex-shrink: 0;
}

.info {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.desc {
  color: #909399;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.meta {
  color: #606266;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}
