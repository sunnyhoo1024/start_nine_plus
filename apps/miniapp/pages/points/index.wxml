<view class="page">
  <view class="card balance">
    <view class="label">当前余额</view>
    <view class="value">{{balance}}</view>
    <button class="btn-primary" size="mini" bindtap="refresh">刷新</button>
  </view>

  <view class="card">
    <view class="section-title">积分流水</view>
    <view wx:if="{{!ledger.length}}" class="muted">暂无记录</view>
    <view class="row" wx:for="{{ledger}}" wx:key="id">
      <view class="left">
        <view class="biz">{{item.bizType}}</view>
        <view class="muted">{{item.createdAt}} · {{item.remark || ''}}</view>
      </view>
      <view class="amount {{item.changeAmount >= 0 ? 'plus' : 'minus'}}">
        {{item.changeAmount >= 0 ? '+' : ''}}{{item.changeAmount}}
      </view>
    </view>
  </view>
</view>
