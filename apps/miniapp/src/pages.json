{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^SnpToast$": "@/components/SnpToast/SnpToast.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "START NINE+",
        "navigationBarBackgroundColor": "#e0e0e0",
        "navigationBarTextStyle": "black"
      }
    },
    {
      "path": "pages/lottery/index",
      "style": {
        "navigationBarTitleText": "星光抽奖",
        "navigationBarBackgroundColor": "#e0e0e0",
        "navigationBarTextStyle": "black"
      }
    },
    {
      "path": "pages/redeem/index",
      "style": {
        "navigationBarTitleText": "积分兑换",
        "navigationBarBackgroundColor": "#e0e0e0",
        "navigationBarTextStyle": "black"
      }
    },
    {
      "path": "pages/points/index",
      "style": {
        "navigationBarTitleText": "我的积分",
        "navigationBarBackgroundColor": "#e0e0e0",
        "navigationBarTextStyle": "black"
      }
    },
    {
      "path": "pages/profile/index",
      "style": {
        "navigationBarTitleText": "我的",
        "navigationBarBackgroundColor": "#e0e0e0",
        "navigationBarTextStyle": "black"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "START NINE+",
    "navigationBarBackgroundColor": "#e0e0e0",
    "backgroundColor": "#e0e0e0"
  },
  "tabBar": {
    "color": "#7a7a7a",
    "selectedColor": "#ff4d3a",
    "backgroundColor": "#e0e0e0",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "static/tab/home.png",
        "selectedIconPath": "static/tab/home-active.png"
      },
      {
        "pagePath": "pages/lottery/index",
        "text": "抽奖",
        "iconPath": "static/tab/lottery.png",
        "selectedIconPath": "static/tab/lottery-active.png"
      },
      {
        "pagePath": "pages/redeem/index",
        "text": "兑换",
        "iconPath": "static/tab/redeem.png",
        "selectedIconPath": "static/tab/redeem-active.png"
      },
      {
        "pagePath": "pages/points/index",
        "text": "积分",
        "iconPath": "static/tab/points.png",
        "selectedIconPath": "static/tab/points-active.png"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的",
        "iconPath": "static/tab/profile.png",
        "selectedIconPath": "static/tab/profile-active.png"
      }
    ]
  }
}
