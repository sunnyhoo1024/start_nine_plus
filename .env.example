# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=start_nine_plus
MYSQL_USER=snp
MYSQL_PASSWORD=snp_change_me
# Used by docker compose mysql service init
MYSQL_ROOT_PASSWORD=root_change_me

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (use long random strings in production)
ADMIN_JWT_SECRET=change-me-admin-jwt-secret-at-least-32-chars
APP_JWT_SECRET=change-me-app-jwt-secret-at-least-32-chars

# WeChat Mini Program
WECHAT_MINI_APPID=wx_your_appid
WECHAT_MINI_SECRET=your_app_secret
# Set true to skip real WeChat call in local/dev (uses code as openid suffix)
WECHAT_MOCK=true

# OSS (optional; leave empty to store local path/url only)
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_PUBLIC_BASE_URL=

# CORS for admin web
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
