# 本地开发环境（可提交仓库；流水线 / 本机默认用此文件）
# 敏感值请用占位或本地覆盖；生产密钥勿写死在此长期使用
#
# Compose: docker compose --env-file ../.env up -d mysql redis
# 或: ./scripts/dc.sh dev up -d mysql redis

SNP_ENV_FILE=../.env

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=start_nine_plus
MYSQL_USER=snp
MYSQL_PASSWORD=snp_change_me
MYSQL_ROOT_PASSWORD=root_change_me

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- JWT ----------
ADMIN_JWT_SECRET=change-me-admin-jwt-secret-at-least-32-chars
APP_JWT_SECRET=change-me-app-jwt-secret-at-least-32-chars
JWT_SECRET=change-me-admin-jwt-secret-at-least-32-chars

# ---------- 微信小程序 ----------
WECHAT_APP_ID=
WECHAT_SECRET=
WECHAT_MOCK=true

# ---------- OSS（可选）----------
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_PUBLIC_BASE_URL=

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
