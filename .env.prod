# 生产环境（可提交仓库结构；流水线用 --env-file .env.prod）
# 正式密钥建议由 CI/CD 或服务器注入覆盖，勿把真实 Secret 长期明文提交
# Compose: docker compose --env-file ../.env.prod up -d --build mysql redis admin-api app-api
# 或: ./scripts/dc.sh prod up -d --build

SNP_ENV_FILE=../.env.prod

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=start_nine_plus
MYSQL_USER=snp
MYSQL_PASSWORD=CHANGE_ME_prod_mysql_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_prod_root_password

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_prod_redis_password

# ---------- JWT（须与 stg/本地不同）----------
ADMIN_JWT_SECRET=CHANGE_ME_prod_admin_jwt_at_least_32_chars!
APP_JWT_SECRET=CHANGE_ME_prod_app_jwt_at_least_32_chars!!!
JWT_SECRET=CHANGE_ME_prod_admin_jwt_at_least_32_chars!

# ---------- 微信（生产必须真实登录）----------
WECHAT_APP_ID=
WECHAT_SECRET=
WECHAT_MOCK=false

# ---------- OSS（生产建议配置）----------
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_PUBLIC_BASE_URL=

# ---------- CORS ----------
CORS_ORIGINS=https://admin.example.com
